    <bib:Article rdf:about="https://arxiv.org/abs/1812.00300">
        <z:itemType>journalArticle</z:itemType>
        <dcterms:isPartOf>
            <bib:Journal>
               <dc:identifier>DOI 10.48550/arxiv.1812.00300</dc:identifier>
            </bib:Journal>
