                    </foaf:Person>
                </rdf:li>
                <rdf:li>
                    <foaf:Person>
                        <foaf:surname>Chintalapati</foaf:surname>
                        <foaf:givenName>Phaneendra Varma</foaf:givenName>
                    </foaf:Person>
                </rdf:li>
