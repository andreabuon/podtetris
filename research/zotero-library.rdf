                    <foaf:Person>
                        <foaf:surname>Rodriguez</foaf:surname>
                        <foaf:givenName>Maria A.</foaf:givenName>
                    </foaf:Person>
                </rdf:li>
                <rdf:li>
                    <foaf:Person>
                        <foaf:surname>Buyya</foaf:surname>
                        <foaf:givenName>Rajkumar</foaf:givenName>
                    </foaf:Person>
                </rdf:li>
