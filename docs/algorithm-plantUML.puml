@startuml PODTetris

title PODTetris Algorithm architecture

start

partition "Snapshot acquisition & Isolation" {
    :Capture a snapshot of the real cluster;
    note right: The nodes in the cluster and the Pods on them
    :Initialize the simulation sandbox;
}

partition "Node selection" {
    if (Is there at least a Node with no user-fixed Pods?) then (Yes)
        :Create working node sets;
        ' Outer loop to collect multiple node sets
        repeat
            ' Inner loop to ensure the selected subset is valid
            repeat
                :Select some Nodes in the sandbox;
            repeat while (Does the subset include at least one Node with no user-fixed Pods?) is (No)
            :Add node set to working set;
        repeat while (Are there more node sets to generate?) is (Yes)

    else (No)
        stop
    endif
}

repeat
    :Select nodes set;
    partition "Permutations generation" {
        :Save the list of allocated Pods in the selected nodes;
        :Virtually evict movable Pods from the selected nodes;
        note right
            The following Pods types are not evicted:
            - Pods fixed to the Node by the user
            - kube-system Pods
            - DaemonSets
            - Jobs
            - Terminating Pods
            - Pods with local storage.
        end note

        :Generate multiple Pod permutations;
        note right
            Different strategies are possible: decreasing Request size,
            Priority-based ordering, random, etc.
        end note
        note right
            Pods with PodAffinity might need to be next to
            each other in the scheduling ordering.
        end note
    }

    partition "Bin-Packing simulation" {
        while (Are there remaining Pods permutations to evaluate?) is (Yes)
            :Initialize a temporary sandbox;
            while (Are there remaining Pods in the current permutation?) is (Yes)
                :Simulate the Pod scheduling onto the WHOLE cluster;
                note right: Leveraging the Kubernetes scheduler with the MostAllocated scoring strategy
            endwhile (No)

            if (Does the new cluster state contain any empty Nodes?) then (Yes)
                note right
                    A Node is considered Empty if it contains no user Pods.
                    The following are excluded from this check:
                    - DaemonSets
                    - Jobs / CronJobs
                    - kube-system Pods
                endnote
                :Calculate the related metrics of the resulting new state;
                note left
                    The success metric is a combination of:
                    - the number of Nodes reduced by the re-allocation
                    - the total number and cost of the pods relocation
                    The cost is calculated by adding the cost/weight of each relocated pod.
                end note
                :Save the permutation result metrics;
            else (No)
                :Skip this permutation;
            endif

        endwhile (No)
    }

repeat while (Is there another Node Set to evaluate?) is (Yes)

if (Did any result reduce the total Nodes count?) then (Yes)
    :Select the best simulated new cluster state;
else (No)
    :No safe infrastructure cost reduction found;
    stop
endif

partition "Consolidation Execution" {
    :Calculate the optimal temporal migration sequence;

    while (Are there remaining Pods to migrate in the sequence?) is (Yes)
        :"Move" the Pod;
        note right
            1. Delete the legacy Pod
            2. Put the replacement Pod on the target Node
            3. Await "Running" status
        end note
    endwhile

    :Cluster Autoscaler terminates remaining empty nodes;
}

stop
@enduml